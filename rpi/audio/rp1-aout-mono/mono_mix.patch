+
+/*
+ * Downmix: replace both channels with (L + R) / 2, so that either AAUD pin
+ * on its own carries the whole stereo image. Runs in place on the DMA
+ * buffer via the dmaengine PCM "process" hook, after the copy from user
+ * space. Halving rather than summing keeps unity gain on mono material.
+ */
+static int rp1_aout_process(struct snd_pcm_substream *substream,
+			    int channel, unsigned long hwoff,
+			    unsigned long bytes)
+{
+	s16 *buf = (s16 *)(substream->runtime->dma_area + hwoff);
+	unsigned long frames = bytes / 4; /* S16_LE interleaved stereo */
+	unsigned long i;
+
+	for (i = 0; i < frames; i++) {
+		int m = ((int)buf[2 * i] + (int)buf[2 * i + 1]) / 2;
+
+		buf[2 * i] = (s16)m;
+		buf[2 * i + 1] = (s16)m;
+	}
+
+	return 0;
+}
+
+/*
+ * The process hook runs only on read/write transfers, so withhold the MMAP
+ * flags to stop clients writing to the buffer directly and bypassing it.
+ * Supplying pcm_hardware skips the dmaengine defaults entirely, so this
+ * restates them, minus MMAP.
+ */
+static const struct snd_pcm_hardware rp1_aout_pcm_hardware = {
+	.info = SNDRV_PCM_INFO_INTERLEAVED,
+	.periods_min = 2,
+	.periods_max = UINT_MAX,
+	.period_bytes_min = 256,
+	.period_bytes_max = 64 * 1024,
+	.buffer_bytes_max = 512 * 1024,
+	.fifo_size = 16,
+};
+
+/* prepare_slave_config is otherwise supplied by the dmaengine default */
+static const struct snd_dmaengine_pcm_config rp1_aout_mono_dma_config = {
+	.prepare_slave_config = snd_dmaengine_pcm_prepare_slave_config,
+	.process = rp1_aout_process,
+	.pcm_hardware = &rp1_aout_pcm_hardware,
+	.prealloc_buffer_size = 64 * 1024,
 };
 
